{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/generated",
      "!**/build",
      "!**/scratch",
      "!**/.local",
      "!**/.venv",
      "!**/routeTree.gen.ts",
      "!**/drizzle/meta",
      "!**/.output",
      "!**/.vercel",
      "!**/.tanstack",
      "!**/.nitro",
      "!**/dist",
      "!**/__pycache__",
      "!**/.ruff_cache"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "enabled": true
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noNonNullAssertedOptionalChain": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConsistentArrayType": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noUnsafeTypeAssertion": "error",
        "noUnsafeReturn": "error"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "javascript": {
    "globals": ["process"]
  }
}
