{
  "name": "of-electric-sheep",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,inngest \"pnpm dev:web\" \"pnpm dev:inngest\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "lint": "biome ci .",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "script": "tsx --env-file=.env",
    "test:systemone": "pnpm run script scripts/test-systemone-api.ts",
    "dev:web": "INNGEST_DEV=1 node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "dev:inngest": "inngest dev --host 127.0.0.1 --no-discovery -u http://localhost:5173/api/inngest"
  },
  "dependencies": {
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@orpc/openapi": "1.16.3",
    "@orpc/server": "1.16.3",
    "@orpc/zod": "1.16.3",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@typesafe-ai/sdk": "0.7.0",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.2",
    "lucide-react": "^1.75.0",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "inngest-cli": "^1.53.0",
    "nitro": "3.0.261103-rc",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8"
  }
}
