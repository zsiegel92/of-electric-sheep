# make env substitutes random values in the placeholders when creating .env.
AUTH_SECRET=__LOCAL_AUTH_SECRET__
DATABASE_URL=postgresql://sheep:__LOCAL_DB_PASSWORD__@127.0.0.1:54873/of_electric_sheep
AUTH_ORIGINS=["http://localhost:5173","http://localhost:8080"]
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub account IDs. Get yours with gh api user --jq .id
ALLOWED_GITHUB_USER_IDS=

TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
# Optional comma-separated upstream URLs selectable when editing pipeline versions.
TYPESAFE_PIPELINE_BASE_URLS=

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional old database used by make db-copy-data.
OLD_DATABASE_URL=

# Optional local live TypeSafe smoke-test key.
SYSTEM_ONE_TEST_API_KEY=__LOCAL_SYSTEM_ONE_TEST_API_KEY__

# Backend endpoints for the corresponding Vite workflows.
SHEEP_MODAL_SERVE_URL=
SHEEP_DEPLOYED_BACKEND_URL=

# Set these two keys in the Modal Inngest secret for cloud execution.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional deploy-time sync credential. Keep it in your local shell or .env.
INNGEST_API_KEY=
